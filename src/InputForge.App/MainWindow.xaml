<Window x:Class="InputForge.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="InputForge" Width="1440" Height="850" MinWidth="800" MinHeight="510"
 Background="{StaticResource Background}" Foreground="{StaticResource Text}"
 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="Header" Grid.Row="0" Height="56" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
   <DockPanel Margin="18,0" LastChildFill="True">
    <StackPanel x:Name="CaptionButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="9,0,0,0"/>
    <Button x:Name="Toggle" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Toggle mapping"/>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <Path Fill="{StaticResource Accent}" Data="M 5,0 L 19,0 15,5 8,5 6,9 14,9 10,14 5,14 1,20 0,11 Z" Margin="0,0,10,0"/>
     <TextBlock Text="InputForge" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBlock x:Name="ProfileLabel" Margin="0,0,16,0"/>
     <Ellipse x:Name="ConnectionDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0"/>
     <TextBlock x:Name="ConnectionLabel" Foreground="{StaticResource Muted}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="SidebarPanel" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
    <StackPanel x:Name="Navigation" Width="216" Margin="12,24"/>
   </Border>
   <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24"
      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
 </Grid>
</Window>
