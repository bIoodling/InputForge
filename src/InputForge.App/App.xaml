<Application x:Class="InputForge.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Background" Color="#080808"/>
  <SolidColorBrush x:Key="Sidebar" Color="#0C0C0D"/>
  <SolidColorBrush x:Key="Panel" Color="#111113"/>
  <SolidColorBrush x:Key="Elevated" Color="#171719"/>
  <SolidColorBrush x:Key="Border" Color="#222225"/>
  <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
  <SolidColorBrush x:Key="Muted" Color="#77777F"/>
  <SolidColorBrush x:Key="Accent" Color="#DC2626"/>
  <SolidColorBrush x:Key="HoverAccent" Color="#EF4444"/>
  <SolidColorBrush x:Key="Active" Color="#2A1013"/>
  <SolidColorBrush x:Key="Disabled" Color="#353538"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="Background" Value="{StaticResource Elevated}"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Active}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter TargetName="Surface" Property="Background" Value="{StaticResource Disabled}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Focusable" Value="True"/>
   <Setter Property="Height" Value="22"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
       <Border Height="2" Background="{StaticResource Border}" Margin="5,0"/>
       <Track x:Name="PART_Track" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="Slider.DecreaseLarge">
          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="2" Background="{StaticResource Accent}"/></Grid></ControlTemplate></RepeatButton.Template>
         </RepeatButton>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="Slider.IncreaseLarge">
          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate></RepeatButton.Template>
         </RepeatButton>
        </Track.IncreaseRepeatButton>
        <Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource Accent}" Stroke="{StaticResource HoverAccent}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Application.Resources>
</Application>
