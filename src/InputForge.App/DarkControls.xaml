<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1B1B20"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#141417"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F5F5F7"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F5F5F7"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#321114"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F5F5F7"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#29292F"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F5F5F7"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#92929D"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#141417"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F5F5F7"/>

 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="11"/>
  <Setter Property="Background" Value="#141417"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ScrollBar">
     <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="2">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
       <Track.DecreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton>
       </Track.DecreaseRepeatButton>
       <Track.Thumb>
        <Thumb MinHeight="24"><Thumb.Template>
         <ControlTemplate TargetType="Thumb">
          <Border x:Name="Grip" Background="#505059" CornerRadius="4"/>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#747480"/></Trigger>
           <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#92929D"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </Thumb.Template></Thumb>
       </Track.Thumb>
       <Track.IncreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton>
       </Track.IncreaseRepeatButton>
      </Track>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="Orientation" Value="Horizontal">
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="Height" Value="11"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="ScrollBar">
       <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="2">
        <Track x:Name="PART_Track">
         <Track.Thumb><Thumb MinWidth="22" Background="#505059"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
       </Border>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Trigger>
  </Style.Triggers>
 </Style>

 <Style TargetType="ComboBoxItem">
  <Setter Property="Foreground" Value="#F5F5F7"/>
  <Setter Property="Padding" Value="10,8"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#29292F"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#321114"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#92929D"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="MinHeight" Value="40"/>
  <Setter Property="Foreground" Value="#F5F5F7"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="Shell" Background="#1B1B20" BorderBrush="#29292F" BorderThickness="1" CornerRadius="8" Padding="12,0">
        <Path Data="M 0,0 L 4,4 8,0" Stroke="#92929D" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#92929D"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#DC2626"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,28,0" IsHitTestVisible="False"/>
     <Border x:Name="FocusRing" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="#141417" BorderBrush="#29292F" BorderThickness="1" CornerRadius="8" Padding="4"
        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#EF4444"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".58"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>

 <Style TargetType="TextBox">
  <Setter Property="Foreground" Value="#F5F5F7"/>
  <Setter Property="Background" Value="#1B1B20"/>
  <Setter Property="CaretBrush" Value="#F5F5F7"/>
  <Setter Property="SelectionBrush" Value="#DC2626"/>
  <Setter Property="BorderBrush" Value="#29292F"/>
  <Setter Property="Padding" Value="11,8"/>
  <Setter Property="MinHeight" Value="40"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="TextBox">
    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#505059"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#EF4444"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".58"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="#F5F5F7"/>
  <Setter Property="MinHeight" Value="32"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="CheckBox">
    <StackPanel Background="Transparent" Orientation="Horizontal">
     <Border x:Name="Box" Width="18" Height="18" Background="#1B1B20" BorderBrush="#505059" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
      <Path x:Name="Check" Data="M 1,5 L 4,8 10,1" Stroke="#F5F5F7" StrokeThickness="1.7"
        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#DC2626"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#92929D"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#EF4444"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".58"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBox">
  <Setter Property="Background" Value="#141417"/>
  <Setter Property="Foreground" Value="#F5F5F7"/>
  <Setter Property="BorderBrush" Value="#29292F"/>
 </Style>
 <Style TargetType="ContextMenu">
  <Setter Property="Background" Value="#141417"/>
  <Setter Property="Foreground" Value="#F5F5F7"/>
  <Setter Property="BorderBrush" Value="#29292F"/>
 </Style>
 <Style TargetType="ToolTip">
  <Setter Property="Foreground" Value="#F5F5F7"/>
  <Setter Property="Background" Value="#1B1B20"/>
  <Setter Property="BorderBrush" Value="#29292F"/>
  <Setter Property="Padding" Value="9,6"/>
 </Style>
</ResourceDictionary>
